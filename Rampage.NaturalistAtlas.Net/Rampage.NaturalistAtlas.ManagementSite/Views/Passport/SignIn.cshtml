@{
    // 登录页：独立布局（Layout=null），左侧品牌视觉 + 右侧登录表单
    Layout = null;

    SuperViewInfo viewInfo = ViewBag.ViewInfo;
    LocalizationModule gl = viewInfo.GlobalLanguage;
}
<!DOCTYPE html>
<html lang="zh-CN" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(gl.Get("Login")) - @AppInfo.Name</title>
    <link rel="icon" type="image/svg+xml" href="~/assets/img/logo-mark.svg" />
    <link rel="stylesheet" href="~/assets/vendor/bootstrap5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/fontawesome.free.7.2.0/css/all.min.css" />
    <link rel="stylesheet" href="~/assets/css/admin-shell.css?v=@AppInfo.ResVer" />
    <link rel="stylesheet" href="~/assets/css/admin-auth.css?v=@AppInfo.ResVer" />
</head>
<body class="sp-auth-body">
    <div class="sp-auth">
        <section class="sp-auth__visual">
            <div class="sp-auth__brand">
                <img class="sp-auth-logo" src="~/assets/img/logo-mark.svg" alt="自然地图志标志" />
                <div class="sp-auth-badge"><i class="fa-solid fa-leaf"></i> Naturalist Atlas</div>
                <h1>自然地图志</h1>
                <p>自然探索观察地图的解读与治理入口——从 iNaturalist 与 GBIF 的全球观察资源起步，采集调度、内容审核与数据配置在此统一管理。请使用获授权的管理员账号登录。</p>
            </div>
        </section>
        <section class="sp-auth__panel">
            <div class="sp-auth__card">
                <h2>@(gl.Get("Welcome"))</h2>
                <p class="sp-auth-sub">@(gl.Get("PleaseLogin"))</p>
                <form id="LoginForm" name="LoginForm" method="post" action="~/api/passport/login">
                    <div class="mb-3">
                        <label class="form-label" for="txtAccount">@(gl.Get("Account"))</label>
                        <input class="form-control" id="txtAccount" name="Account" placeholder="@(gl.Get("Username"))/@(gl.Get("MobileNumber"))/@(gl.Get("Email"))" type="text" autocomplete="username" autofocus />
                        <div class="invalid-feedback" verify-name="Account"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" for="txtPassword">@(gl.Get("Password"))</label>
                        <div class="sp-auth-password">
                            <input class="form-control" id="txtPassword" name="Password" placeholder="@(gl.Get("Password"))" type="password" autocomplete="current-password" />
                            <button type="button" class="sp-auth-password__toggle" data-sp-password-toggle aria-label="显示或隐藏密码" tabindex="-1">
                                <i class="fa-regular fa-eye"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback" verify-name="Password"></div>
                    </div>
                    @if (ViewBag.CaptchaEnabled == true)
                    {
                        <div class="mb-3" id="captchaRow" style="display:none;">
                            <label class="form-label" for="txtCaptcha">@(gl.Get("Captcha") ?? "验证码")</label>
                            <div class="sp-captcha">
                                <input class="form-control" id="txtCaptcha" name="CaptchaCode" type="text" maxlength="16" autocomplete="off" />
                                <img id="imgCaptcha" class="sp-captcha__img" alt="@(gl.Get("Captcha") ?? "验证码")" title="@(gl.Get("CaptchaRefresh") ?? "换一张")" />
                            </div>
                            <div class="invalid-feedback" verify-name="CaptchaCode"></div>
                        </div>
                        <div class="mb-3" id="captchaClickRow" style="display:none;">
                            <label class="form-label">@(gl.Get("Captcha") ?? "验证码")<span id="captchaTip" class="sp-captcha__tip"></span></label>
                            <div class="sp-captcha-click" id="captchaClickArea">
                                <img id="imgCaptchaClick" alt="@(gl.Get("Captcha") ?? "验证码")" />
                            </div>
                            <button type="button" id="btnCaptchaRefresh" class="btn btn-link btn-sm px-0 sp-captcha__refresh">
                                <i class="fa-solid fa-rotate-right me-1"></i>@(gl.Get("CaptchaRefresh") ?? "换一张")
                            </button>
                        </div>
                    }
                    <div class="mb-3 form-check">
                        <input class="form-check-input" type="checkbox" value="true" id="chkIsRemember" name="IsRemember" />
                        <label class="form-check-label" for="chkIsRemember">@(gl.Get("RememberMe"))</label>
                    </div>
                    <button type="submit" id="btnLogin" class="btn btn-primary w-100"><i class="fa-solid fa-right-to-bracket me-1"></i>@gl.Get("SignIn")</button>
                    <div id="tipMessage" class="sp-tip" style="display:none;"></div>
                </form>
            </div>
        </section>
    </div>

    <input type="hidden" id="hdReturnUrl" value="@Html.Encode(ViewBag.ReturnUrl ?? "/")" />

    <script src="~/assets/vendor/jquery3.7.1/jquery-3.7.1.min.js"></script>
    <script src="~/assets/vendor/bootstrap5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/rpg-core.js?v=@AppInfo.ResVer"></script>
    <script>
        $(function () {
            // 登录验证码状态（服务端按 LoginCaptcha 配置决定是否启用；令牌一次性，提交即消费）
            var captcha = {
                enabled: @(ViewBag.CaptchaEnabled == true ? "true" : "false"),
                token: '',
                mode: 'input',
                points: []
            };

            // 点选标记序号重画：位置由 captcha.points（自然像素）按当前显示尺寸换算
            function renderCaptchaMarks() {
                var $area = $('#captchaClickArea');
                $area.find('.sp-captcha__mark').remove();
                if (!captcha.points.length) { return; }
                var img = document.getElementById('imgCaptchaClick');
                var rect = img.getBoundingClientRect();
                var scaleX = rect.width / img.naturalWidth;
                var scaleY = rect.height / img.naturalHeight;
                for (var i = 0; i < captcha.points.length; i++) {
                    var p = captcha.points[i];
                    $('<span class="sp-captcha__mark"></span>')
                        .text(i + 1)
                        .css({ left: (p.X * scaleX) + 'px', top: (p.Y * scaleY) + 'px' })
                        .data('idx', i)
                        .appendTo($area);
                }
            }

            function loadCaptcha() {
                RPG.Get('/api/passport/captcha', null, function (r) {
                    if (!r || !r.IsSuccess || !r.Data) { return; }
                    var d = r.Data;
                    captcha.token = d.Token;
                    captcha.mode = d.Mode;
                    captcha.points = [];
                    if (d.Mode === 'click') {
                        $('#captchaRow').hide();
                        $('#captchaClickRow').show();
                        $('#imgCaptchaClick').attr('src', 'data:image/png;base64,' + d.Base64);
                        $('#captchaTip').text(d.Tip || '');
                        renderCaptchaMarks();
                    } else {
                        $('#captchaClickRow').hide();
                        $('#captchaRow').show();
                        $('#imgCaptcha').attr('src', 'data:image/png;base64,' + d.Base64);
                        $('#txtCaptcha').val('').attr('placeholder', d.Tip || '');
                    }
                });
            }

            if (captcha.enabled) {
                // 点选采点：换算成图片自然像素（单词点选图 440 宽会缩放显示，不可假设 1:1）
                $('#imgCaptchaClick').on('click', function (e) {
                    var rect = this.getBoundingClientRect();
                    captcha.points.push({
                        X: Math.round((e.clientX - rect.left) * (this.naturalWidth / rect.width) * 10) / 10,
                        Y: Math.round((e.clientY - rect.top) * (this.naturalHeight / rect.height) * 10) / 10
                    });
                    renderCaptchaMarks();
                });
                // 点击标记 = 删除该点（阻止冒泡，避免在图上误采点）
                $('#captchaClickArea').on('click', '.sp-captcha__mark', function (e) {
                    e.stopPropagation();
                    captcha.points.splice($(this).data('idx'), 1);
                    renderCaptchaMarks();
                });
                // 图形验证码点击图片换一张
                $('#imgCaptcha').on('click', loadCaptcha);
                $('#btnCaptchaRefresh').on('click', loadCaptcha);
                loadCaptcha();
            }

            // 登录接口为 [FromBody]，须 JSON（useBody:true）；表单编码会 415
            RPG.FormSubmitter('LoginForm', {
                prepareHandler: function (data) {
                    data.IsRemember = $('#chkIsRemember').is(':checked');
                    if (captcha.enabled) {
                        data.CaptchaToken = captcha.token;
                        if (captcha.mode === 'click') {
                            data.CaptchaPoints = captcha.points;
                        }
                    }
                },
                completeHandler: function (jsonResult) {
                    // 登录成功：携带服务端校验过的本地 returnUrl 跳转
                    var returnUrl = $('#hdReturnUrl').val() || '/';
                    location.href = returnUrl;
                },
                failHandler: function () {
                    // 验证码令牌已被一次性消费，失败后必刷新；再聚焦密码框并全选
                    if (captcha.enabled) { loadCaptcha(); }
                    $('#txtPassword').trigger('focus').trigger('select');
                },
                useBody: true,
                tipContainerId: 'tipMessage',
                tipAutoHidden: 1,
                verifyFeedback: 1
            });

            // 密码可见切换：明文/密文互切，图标随状态切换
            $('[data-sp-password-toggle]').on('click', function () {
                var input = $('#txtPassword');
                var icon = $(this).find('i');
                var isText = input.attr('type') === 'text';
                input.attr('type', isText ? 'password' : 'text');
                icon.toggleClass('fa-eye', isText).toggleClass('fa-eye-slash', !isText);
            });
        });
    </script>
</body>
</html>

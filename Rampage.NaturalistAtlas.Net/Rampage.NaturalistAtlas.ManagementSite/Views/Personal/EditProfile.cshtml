@model AdminDto
@{
    // 个人中心 · 资料编辑：回显当前管理员基础资料，保存走框架 api/personal/profile/save
    SuperViewInfo viewInfo = ViewBag.ViewInfo;
    LocalizationModule gl = viewInfo.GlobalLanguage;
    AdminDto data = Model!;
    ViewBag.PageTitle = gl.Get("EditMyProfile");
}

@section Head {
    <link rel="stylesheet" href="~/assets/css/admin-personal.css?v=@AppInfo.ResVer" />
}

<div class="sp-page-head">
    <div>
        <h1 class="sp-page-title"><i class="fa-solid fa-id-card me-2"></i>@(gl.Get("EditMyProfile"))</h1>
    </div>
</div>

<nav class="personal-nav">
    <a class="active" href="~/Personal/EditProfile/"><i class="fa-solid fa-id-card"></i>@(gl.Get("EditMyProfile"))</a>
    <a href="~/Personal/ChangePassword/"><i class="fa-solid fa-key"></i>@(gl.Get("ChangePassword"))</a>
    <a href="~/Personal/AvatarSetting/"><i class="fa-solid fa-circle-user"></i>@(gl.Get("MyProfilePicture"))</a>
</nav>

<div class="sp-panel">
    <div class="sp-panel__hd">
        <h2 class="sp-panel__title"><i class="fa-solid fa-user-pen me-2"></i>基础资料</h2>
    </div>
    <div class="sp-panel__bd">
        <form id="PersonalProfileForm" action="~/api/personal/profile/save" method="post">
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtUsername">@gl.Get("Username")</label>
                <div class="col-sm-10">
                    <input type="text" id="txtUsername" name="Username" class="form-control" value="@data.Username" />
                    <div class="invalid-feedback" verify-name="Username"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtTrueName">@gl.Get("RealName")</label>
                <div class="col-sm-10">
                    <input type="text" id="txtTrueName" name="TrueName" class="form-control" value="@data.TrueName" />
                    <div class="invalid-feedback" verify-name="TrueName"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtMobile">@gl.Get("MobileNumber")</label>
                <div class="col-sm-10">
                    <input type="text" id="txtMobile" name="Mobile" class="form-control" value="@data.Mobile" />
                    <div class="invalid-feedback" verify-name="Mobile"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtEmail">@gl.Get("Email")</label>
                <div class="col-sm-10">
                    <input type="text" id="txtEmail" name="Email" class="form-control" value="@data.Email" />
                    <div class="invalid-feedback" verify-name="Email"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label">@gl.Get("Gender")</label>
                <div class="col-sm-10">
                    <partial name="~/Views/_Component/_EnumRadioBox.cshtml" model='new EnumSelector<UserGender> { FormItemId = "txtGender", FormItemName = "Gender", SelectedValue = data.Gender }' />
                </div>
            </div>
            <div class="d-flex justify-content-center">
                <button class="btn btn-primary px-5" type="submit"><i class="fa-solid fa-floppy-disk me-1"></i>@(gl.Get("SubmitToSave") ?? "保存")</button>
            </div>
            <div id="tipMessage" class="sp-tip" style="display:none;"></div>
        </form>
    </div>
</div>

@section Foot {
    <script>
        $(function () {
            RPG.FormSubmitter('PersonalProfileForm', {
                tipContainerId: 'tipMessage',
                tipAutoHidden: 1,
                verifyFeedback: 1
            });
        });
    </script>
}

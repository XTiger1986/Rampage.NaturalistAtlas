@{
    // 个人中心 · 修改密码：本地校验两次输入一致，保存走框架 api/personal/password/change
    SuperViewInfo ViewInfo = ViewBag.ViewInfo;
    LocalizationModule GL = ViewInfo.GlobalLanguage;
    ViewBag.PageTitle = GL.Get("ChangePassword");
}

@section Head {
    <link rel="stylesheet" href="~/assets/css/admin-personal.css?v=@AppInfo.ResVer" />
}

<div class="sp-page-head">
    <div>
        <h1 class="sp-page-title"><i class="fa-solid fa-key me-2"></i>@(GL.Get("ChangePassword"))</h1>
    </div>
</div>

<nav class="personal-nav">
    <a href="~/Personal/EditProfile/"><i class="fa-solid fa-id-card"></i>@(GL.Get("EditMyProfile"))</a>
    <a class="active" href="~/Personal/ChangePassword/"><i class="fa-solid fa-key"></i>@(GL.Get("ChangePassword"))</a>
    <a href="~/Personal/AvatarSetting/"><i class="fa-solid fa-circle-user"></i>@(GL.Get("MyProfilePicture"))</a>
</nav>

<div class="sp-panel">
    <div class="sp-panel__hd">
        <h2 class="sp-panel__title"><i class="fa-solid fa-shield-halved me-2"></i>凭证更新</h2>
    </div>
    <div class="sp-panel__bd">
        <form id="ChangePasswordForm" action="~/api/personal/password/change" method="post">
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtVerifyPassword">@(GL.Get("OriginalPassword"))</label>
                <div class="col-sm-10">
                    <input type="password" id="txtVerifyPassword" name="VerifyPassword" class="form-control" autocomplete="current-password" />
                    <div class="invalid-feedback" verify-name="VerifyPassword"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtPassword">@(GL.Get("NewPassword"))</label>
                <div class="col-sm-10">
                    <input type="password" id="txtPassword" name="Password" class="form-control" autocomplete="new-password" />
                    <div class="invalid-feedback" verify-name="Password"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtPasswordConfirm">@(GL.Get("ConfirmPassword"))</label>
                <div class="col-sm-10">
                    <input type="password" id="txtPasswordConfirm" name="PasswordConfirm" class="form-control" autocomplete="new-password" />
                    <div class="invalid-feedback" verify-name="PasswordConfirm"></div>
                </div>
            </div>
            <div class="d-flex justify-content-center">
                <button class="btn btn-primary px-5" type="submit"><i class="fa-solid fa-lock me-1"></i>@(GL.Get("SubmitToSave") ?? "保存")</button>
            </div>
            <div id="tipMessage" class="sp-tip" style="display:none;"></div>
        </form>
    </div>
</div>

@section Foot {
    <script>
        $(function () {
            RPG.FormSubmitter('ChangePasswordForm', {
                // 提交前本地校验：两次密码不一致时回填字段错误并中止
                validationHandler: function (formData) {
                    if ((formData.Password || '') !== (formData.PasswordConfirm || '')) {
                        return { PasswordConfirm: '@(GL.Get("TheTwoPasswordEntriesDoNotMatch") ?? "两次输入的密码不一致")' };
                    }
                    return true;
                },
                completeHandler: function (jsonResult) {
                    if (jsonResult.IsSuccess) {
                        $('#ChangePasswordForm')[0].reset();
                    }
                },
                tipContainerId: 'tipMessage',
                tipAutoHidden: 1,
                verifyFeedback: 1
            });
        });
    </script>
}

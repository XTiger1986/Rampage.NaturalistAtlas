@model ListViewData<ManageMenuDto>
@{
    SuperViewInfo viewInfo = ViewBag.ViewInfo;
    TimeZoneInfo ctz = viewInfo.ClientTimeZone!;
    LocalizationModule gl = viewInfo.GlobalLanguage;
    List<ManageMenuDto> dataList = Model!.DataList;
}

@section Head {
    <link rel="stylesheet" href="~/assets/css/admin-admin.css?v=@AppInfo.ResVer" />
}

<div class="sp-page-head">
    <partial name="~/Views/Shared/_BreadCrumb.cshtml" />
    <div class="sp-page-actions">
        <a class="btn btn-primary" href="~/Admin/Menu_Add"><i class="fa-solid fa-plus me-1"></i>@gl.Get("AddManageMenu")</a>
    </div>
</div>

<div class="sp-panel">
    <div class="sp-panel__hd">
        <h2 class="sp-panel__title">@gl.Get("ManageMenuList")</h2>
    </div>
    <div class="sp-panel__bd">
        <div class="sp-table-wrap">
            <table class="table table-hover sp-table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>@gl.Get("Name")</th>
                        <th>@(gl.Get("RelatedFunction"))</th>
                        <th>@(gl.Get("Path"))</th>
                        <th>@(gl.Get("SortValue"))</th>
                        <th>@gl.Get("Status")</th>
                        <th>@gl.Get("CreatedTime")/@gl.Get("UpdateTime")</th>
                        <th>@gl.Get("Operations")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (dataList.Count > 0)
                    {
                        @WebLogicUtility.RenderMenuTreeTableHtml(dataList, gl, ctz)
                    }
                    else
                    {
                        <tr><td colspan="8" class="sp-empty">@gl.Get("NoData")</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Foot {
    <script src="~/assets/js/admin-admin.js?v=@AppInfo.ResVer"></script>
    <script>
        $('button[data-action=disable-menu],button[data-action=enable-menu]').on('click', function () {
            var btn = $(this);
            var id = btn.attr('data-id');
            var isToDisable = btn.attr('data-action') === 'disable-menu';
            var text = isToDisable ? '@(gl.Get("ConfirmDisableMenuText"))' : '@(gl.Get("ConfirmEnableMenuText"))';

            RPG.confirm(text, function () {
                btn.prop('disabled', true);
                RPG.Post('/api/admin/menu/status/change', { MenuId: id, Status: isToDisable ? 0 : 1 }, function (jsonResult) {
                    btn.prop('disabled', false);
                    if (jsonResult.IsSuccess) {
                        RPG.showSuccessTip(jsonResult.Message);
                        var tr = $('#trDataItem_' + id);
                        if (isToDisable) {
                            tr.find('.menu-status-enabled').hide();
                            tr.find('.menu-status-disabled').show();
                            tr.find('[data-action=disable-menu]').hide();
                            tr.find('[data-action=enable-menu]').show();
                        } else {
                            tr.find('.menu-status-enabled').show();
                            tr.find('.menu-status-disabled').hide();
                            tr.find('[data-action=disable-menu]').show();
                            tr.find('[data-action=enable-menu]').hide();
                        }
                    } else {
                        RPG.showErrorTip(jsonResult.Message);
                    }
                });
            });
        });

        AdminPages.bindDelete('[data-action=delete-menu]', function (id) {
            return '/api/admin/menu/delete/' + id;
        }, '@(gl.Get("ConfirmDeleteMenuText"))');
    </script>
}

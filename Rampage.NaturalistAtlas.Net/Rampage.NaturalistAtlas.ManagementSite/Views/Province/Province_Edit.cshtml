@model Province
@{
    // 省份编辑：新增/编辑共用（Id<=0 为新增）；保存走 api/province/save
    SuperViewInfo ViewInfo = ViewBag.ViewInfo;
    LocalizationModule GL = ViewInfo.GlobalLanguage;
    Province Data = Model!;
    bool IsCreate = Data.Id <= 0;
    ViewBag.PageTitle = IsCreate ? "添加省份" : "编辑省份";
    List<Country> CountryList = ViewBag.CountryList ?? new List<Country>();
}

@section Head {
    <link rel="stylesheet" href="~/assets/css/admin-city.css?v=@AppInfo.ResVer" />
}

<div class="sp-page-head">
    <partial name="~/Views/Shared/_BreadCrumb.cshtml" />
    <div class="sp-page-actions">
        <a class="btn btn-outline-secondary" href="~/Province/Province_List"><i class="fa-solid fa-arrow-left me-1"></i>返回列表</a>
    </div>
</div>

<div class="sp-panel">
    <div class="sp-panel__hd">
        <h2 class="sp-panel__title"><i class="fa-solid fa-map me-2"></i>@(IsCreate ? "添加省份" : $"编辑省份 - {Data.Name}")</h2>
    </div>
    <div class="sp-panel__bd">
        <div class="setting-hint">
            <i class="fa-solid fa-circle-info me-1"></i>
            区划码须为 ISO 3166-2 风格（如 CN-BJ / JP-13）且同一国家内唯一；无官方区划码时可留空。
        </div>

        <form id="ProvinceForm" action="~/api/province/save" method="post">
            <input type="hidden" name="Id" value="@Data.Id" />
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="seltCountryId">所属国家</label>
                <div class="col-sm-10">
                    <select id="seltCountryId" name="CountryId" class="form-select" style="max-width:320px">
                        <option value="">请选择国家</option>
                        @foreach (var country in CountryList)
                        {
                            <option value="@country.Id" selected="@(Data.CountryId == country.Id)">@country.Name（@country.Code）</option>
                        }
                    </select>
                    <div class="invalid-feedback" verify-name="CountryId"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtCode">区划码</label>
                <div class="col-sm-10">
                    <input type="text" id="txtCode" name="Code" class="form-control sp-mono" style="max-width:160px" maxlength="10" value="@Data.Code" placeholder="如 CN-BJ" />
                    <div class="form-text">ISO 3166-2 风格，同一国家内唯一；可留空。</div>
                    <div class="invalid-feedback" verify-name="Code"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtName">中文名</label>
                <div class="col-sm-10">
                    <input type="text" id="txtName" name="Name" class="form-control" style="max-width:320px" value="@Data.Name" placeholder="如 广东省" />
                    <div class="invalid-feedback" verify-name="Name"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtNameEn">英文名</label>
                <div class="col-sm-10">
                    <input type="text" id="txtNameEn" name="NameEn" class="form-control" style="max-width:320px" value="@Data.NameEn" placeholder="如 Guangdong" />
                    <div class="invalid-feedback" verify-name="NameEn"></div>
                </div>
            </div>
            <div class="setting-section-title"><i class="fa-solid fa-location-crosshairs"></i>定位中心点（前端地点搜索定位用）</div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtLng">经度 / 纬度</label>
                <div class="col-sm-10">
                    <div class="city-bbox-pair">
                        <input type="number" step="0.000001" id="txtLng" name="Lng" class="form-control sp-mono" value="@Data.Lng" placeholder="经度 -180 ~ 180" />
                        <input type="number" step="0.000001" name="Lat" class="form-control sp-mono" value="@Data.Lat" placeholder="纬度 -90 ~ 90" />
                    </div>
                    <div class="form-text">区划地图定位的中心点（近似值即可，精确到 0.1° 量级）。</div>
                    <div class="invalid-feedback" verify-name="Lng"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label">状态</label>
                <div class="col-sm-10">
                    <partial name="~/Views/_Component/_EnumRadioBox.cshtml"
                             model='new EnumSelector<CommonStatus> { FormItemId = "seltStatus", FormItemName = "Status", SelectedValue = Data.Status == CommonStatus.Enabled ? CommonStatus.Enabled : CommonStatus.Disabled }' />
                </div>
            </div>

            <div class="d-flex justify-content-center">
                <button class="btn btn-primary px-5" type="submit"><i class="fa-solid fa-floppy-disk me-1"></i>@GL.Get("SubmitToSave")</button>
            </div>
            <div id="tipMessage" class="sp-tip" style="display:none;"></div>
        </form>
    </div>
</div>

@section Foot {
    <script>
        $(function () {
            RPG.FormSubmitter('ProvinceForm', {
                validationHandler: function (formData) {
                    if (!formData.CountryId) {
                        return { CountryId: '请选择所属国家' };
                    }
                    return true;
                },
                completeHandler: function (jsonResult) {
                    window.location.href = '/Province/Province_List';
                },
                tipContainerId: 'tipMessage',
                tipAutoHidden: 1,
                verifyFeedback: 1
            });
        });
    </script>
}

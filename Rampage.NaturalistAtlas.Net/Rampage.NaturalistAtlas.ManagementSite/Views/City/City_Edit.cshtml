@model City
@{
    // 城市编辑：新增/编辑共用（Id<=0 为新增）；国家→省份级联下拉，保存走 api/city/save
    SuperViewInfo ViewInfo = ViewBag.ViewInfo;
    LocalizationModule GL = ViewInfo.GlobalLanguage;
    City Data = Model!;
    bool IsCreate = Data.Id <= 0;
    ViewBag.PageTitle = IsCreate ? "添加城市" : "编辑城市";
    List<Country> CountryList = ViewBag.CountryList ?? new List<Country>();
    Province? CurrentProvince = ViewBag.CurrentProvince;
}

@section Head {
    <link rel="stylesheet" href="~/assets/css/admin-city.css?v=@AppInfo.ResVer" />
}

<div class="sp-page-head">
    <partial name="~/Views/Shared/_BreadCrumb.cshtml" />
    <div class="sp-page-actions">
        <a class="btn btn-outline-secondary" href="~/City/City_List"><i class="fa-solid fa-arrow-left me-1"></i>返回列表</a>
    </div>
</div>

<div class="sp-panel">
    <div class="sp-panel__hd">
        <h2 class="sp-panel__title"><i class="fa-solid fa-map-location-dot me-2"></i>@(IsCreate ? "添加城市" : $"编辑城市 - {Data.Name}")</h2>
    </div>
    <div class="sp-panel__bd">
        <div class="setting-hint">
            <i class="fa-solid fa-circle-info me-1"></i>
            bbox 为城市地理围栏，采集端按此范围拉取观察数据；上线前请按行政区划校准四至坐标。
        </div>

        <form id="CityForm" action="~/api/city/save" method="post">
            <input type="hidden" name="Id" value="@Data.Id" />
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="seltCountryId">所属国家</label>
                <div class="col-sm-10">
                    <select id="seltCountryId" name="CountryId" class="form-select" style="max-width:320px">
                        <option value="">请选择国家</option>
                        @foreach (var country in CountryList)
                        {
                            <option value="@country.Id" selected="@(Data.CountryId == country.Id)">@country.Name（@country.Code）</option>
                        }
                    </select>
                    <div class="invalid-feedback" verify-name="CountryId"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="seltProvinceId">所属省份</label>
                <div class="col-sm-10">
                    <select id="seltProvinceId" name="ProvinceId" class="form-select" style="max-width:320px" data-selected="@(Data.ProvinceId)"
                            data-fallback-id="@(CurrentProvince?.Id)" data-fallback-name="@(CurrentProvince?.Name)">
                        <option value="">不设置（城市国家或暂无区划）</option>
                    </select>
                    <div class="form-text">随国家联动加载该国的启用一级区划；已指向的停用省份会以「（已停用）」标注保留，可改选启用区划后保存。</div>
                    <div class="invalid-feedback" verify-name="ProvinceId"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtName">城市名称（中文）</label>
                <div class="col-sm-10">
                    <input type="text" id="txtName" name="Name" class="form-control" style="max-width:320px" value="@Data.Name" placeholder="如：北京" />
                    <div class="invalid-feedback" verify-name="Name"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtNameEn">城市名称（英文）</label>
                <div class="col-sm-10">
                    <input type="text" id="txtNameEn" name="NameEn" class="form-control" style="max-width:320px" value="@Data.NameEn" placeholder="如：Beijing" />
                    <div class="form-text">可空；用于检索与多语言展示。</div>
                    <div class="invalid-feedback" verify-name="NameEn"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="txtSlug">URL标识</label>
                <div class="col-sm-10">
                    <input type="text" id="txtSlug" name="Slug" class="form-control sp-mono" style="max-width:320px" value="@Data.Slug" placeholder="如：beijing" />
                    <div class="form-text">仅允许小写字母、数字与连字符；全站唯一，重名城市建议加国家码（如 cambridge-gb）。</div>
                    <div class="invalid-feedback" verify-name="Slug"></div>
                </div>
            </div>

            <div class="setting-section-title"><i class="fa-solid fa-vector-square"></i>bbox 四至坐标</div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label">西南角（SW）</label>
                <div class="col-sm-10">
                    <div class="city-bbox-pair">
                        <input type="number" step="0.000001" name="SwLng" class="form-control sp-mono" value="@Data.SwLng" placeholder="经度 -180 ~ 180" />
                        <input type="number" step="0.000001" name="SwLat" class="form-control sp-mono" value="@Data.SwLat" placeholder="纬度 -90 ~ 90" />
                    </div>
                    <div class="invalid-feedback" verify-name="SwLng"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label">东北角（NE）</label>
                <div class="col-sm-10">
                    <div class="city-bbox-pair">
                        <input type="number" step="0.000001" name="NeLng" class="form-control sp-mono" value="@Data.NeLng" placeholder="经度 -180 ~ 180" />
                        <input type="number" step="0.000001" name="NeLat" class="form-control sp-mono" value="@Data.NeLat" placeholder="纬度 -90 ~ 90" />
                    </div>
                    <div class="invalid-feedback" verify-name="NeLng"></div>
                </div>
            </div>

            <div class="setting-section-title"><i class="fa-solid fa-satellite-dish"></i>源站档案（iNaturalist）</div>
            <div class="setting-hint">
                <i class="fa-solid fa-circle-info me-1"></i>
                place id 是采集端按行政区划拉取 iNat 数据的定位锚（无值时回退 bbox 范围采集）；边界 WKT 由种子/采集端维护，此处只读核对，修改须走数据脚本。
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label" for="numInatPlaceId">place id</label>
                <div class="col-sm-10">
                    <input type="number" min="1" name="InatPlaceId" id="numInatPlaceId" class="form-control sp-mono" style="max-width:320px"
                           value="@Data.InatPlaceId" placeholder="如 27867（北京）；留空 = 回退 bbox" />
                    <div class="form-text">在 iNaturalist Places 页 URL 中获取（inaturalist.org/places/{id}）。</div>
                    <div class="invalid-feedback" verify-name="InatPlaceId"></div>
                </div>
            </div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label">边界 WKT</label>
                <div class="col-sm-10">
                    @if (!string.IsNullOrEmpty(Data.BoundaryWkt))
                    {
                        <details>
                            <summary class="text-ink-2 small" style="cursor:pointer">已归档边界（点开核对，单行存储）</summary>
                            <pre class="sp-mono mt-2 mb-0" style="white-space:pre-wrap;word-break:break-all;max-height:180px;overflow:auto;font-size:11px">@Data.BoundaryWkt</pre>
                        </details>
                    }
                    else
                    {
                        <span class="text-ink-2 small">未归档（采集按 bbox 矩形）</span>
                    }
                </div>
            </div>

            <div class="setting-section-title"><i class="fa-solid fa-sliders"></i>状态</div>
            <div class="row mb-3">
                <label class="col-sm-2 col-form-label">状态</label>
                <div class="col-sm-10">
                    <partial name="~/Views/_Component/_EnumRadioBox.cshtml"
                             model='new EnumSelector<CommonStatus> { FormItemId = "seltStatus", FormItemName = "Status", SelectedValue = Data.Status == CommonStatus.Enabled ? CommonStatus.Enabled : CommonStatus.Disabled }' />
                    <div class="form-text">停用后主站不再展示该城市，采集任务仍按配置运行。</div>
                </div>
            </div>

            <div class="d-flex justify-content-center">
                <button class="btn btn-primary px-5" type="submit"><i class="fa-solid fa-floppy-disk me-1"></i>@GL.Get("SubmitToSave")</button>
            </div>
            <div id="tipMessage" class="sp-tip" style="display:none;"></div>
        </form>
    </div>
</div>

@section Foot {
    <script>
        $(function () {
            // 国家→省份级联：切换国家时拉取该国启用区划；data-selected 携带回显值
            var $country = $('#seltCountryId');
            var $province = $('#seltProvinceId');

            function loadProvinces(countryId, selectedId) {
                $province.prop('disabled', true).empty()
                    .append($('<option></option>').val('').text('不设置（城市国家或暂无区划）'));
                if (!countryId) { $province.prop('disabled', false); return; }
                $.getJSON('/api/province/list', { countryId: countryId }, function (jsonResult) {
                    if (jsonResult && jsonResult.IsSuccess && jsonResult.Data) {
                        $.each(jsonResult.Data, function (i, item) {
                            $province.append($('<option></option>').val(item.Id).text(item.Name + (item.Code ? '（' + item.Code + '）' : '')));
                        });
                        if (selectedId) { $province.val(String(selectedId)); }
                    }
                    // 级联列表只含启用省份：当前指向的停用省份不在其中时补一个回显项，
                    // 防止下拉显示"不设置"、保存时静默丢掉省市关联
                    // The cascade serves enabled provinces only: when the pointed-to province is
                    // disabled and absent, inject an echo option so saving never silently drops it
                    var fallbackId = $province.data('fallback-id');
                    if (selectedId && String(selectedId) === String(fallbackId)
                        && !$province.find('option[value="' + fallbackId + '"]').length) {
                        var fallbackName = $province.data('fallback-name') || ('#' + fallbackId);
                        $province.append($('<option></option>').val(fallbackId).text(fallbackName + '（已停用）'));
                        $province.val(String(fallbackId));
                    }
                    $province.prop('disabled', false);
                }).fail(function () { $province.prop('disabled', false); });
            }

            $country.on('change', function () { loadProvinces($(this).val(), null); });
            // 初始回显：编辑态用已有国家 + 原省份
            loadProvinces($country.val() || '', $province.data('selected'));

            RPG.FormSubmitter('CityForm', {
                validationHandler: function (formData) {
                    if (!formData.CountryId) {
                        return { CountryId: '请选择所属国家' };
                    }
                    // bbox 交叉校验（服务端亦校验，此处提前给出字段级反馈）
                    var swLng = parseFloat(formData.SwLng), swLat = parseFloat(formData.SwLat);
                    var neLng = parseFloat(formData.NeLng), neLat = parseFloat(formData.NeLat);
                    if (!(swLng < neLng)) { return { SwLng: '西南角经度须小于东北角经度' }; }
                    if (!(swLat < neLat)) { return { SwLat: '西南角纬度须小于东北角纬度' }; }
                    return true;
                },
                prepareHandler: function (data) {
                    // 未选省份时提交空值（表单序列化为 null）
                    if (!data.ProvinceId) { data.ProvinceId = null; }
                    // place id 留空提交 null（避免空串）
                    if (!data.InatPlaceId) { data.InatPlaceId = null; }
                },
                completeHandler: function (jsonResult) {
                    window.location.href = '/City/City_List';
                },
                tipContainerId: 'tipMessage',
                tipAutoHidden: 1,
                verifyFeedback: 1
            });
        });
    </script>
}

@model ListViewData<Country, CountryAdminFilter>
@{
    // 国家列表：代码/中英文名关键字 + 状态筛选；行内编辑/启停/删除
    SuperViewInfo ViewInfo = ViewBag.ViewInfo;
    TimeZoneInfo CTZ = ViewInfo.ClientTimeZone!;
    LocalizationModule GL = ViewInfo.GlobalLanguage;

    List<Country> DataList = Model!.DataList;
    DataPager DataPager = Model!.DataPager!;
    CountryAdminFilter DataFilter = Model!.DataFilter;
}

@section Head {
    <link rel="stylesheet" href="~/assets/css/admin-city.css?v=@AppInfo.ResVer" />
}

<div class="sp-page-head">
    <partial name="~/Views/Shared/_BreadCrumb.cshtml" />
    <div class="sp-page-actions">
        <a class="btn btn-primary" href="~/Country/Country_Add"><i class="fa-solid fa-plus me-1"></i>添加国家</a>
    </div>
</div>

<div class="sp-panel">
    <div class="sp-panel__hd">
        <h2 class="sp-panel__title"><i class="fa-solid fa-earth-asia me-2"></i>国家列表</h2>
    </div>
    <div class="sp-panel__bd">
        <form class="sp-toolbar" action="~/Country/Country_List" method="get">
            <div class="sp-toolbar__filters">
                <partial name="~/Views/_Component/_PageSizeOptions.cshtml" model="DataPager.PageSize" />
                <input type="search" name="Keywords" class="form-control" style="width:220px" placeholder="代码 / 中文名 / 英文名" value="@DataFilter.Keywords" />
                <partial name="~/Views/_Component/_EnumSelector.cshtml"
                         model='new EnumSelector<CommonStatus> { FormItemId = "seltStatus", FormItemName = "Status", Css = "form-select", Style = "width:130px", DefaultText = "全部状态", DefaultValue = "", SelectedValue = DataFilter.Status }' />
                <button type="submit" class="btn btn-primary">@GL.Get("Query")</button>
            </div>
        </form>

        <div class="sp-table-wrap">
            <table class="table table-hover sp-table">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>代码</th>
                        <th>中文名</th>
                        <th>英文名</th>
                        <th>状态</th>
                        <th>创建 / 修改</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                @if (DataList.Count > 0)
                {
                    foreach (var item in DataList)
                    {
                        <tr id="trDataItem_@(item.Id)">
                            <td>@item.Id</td>
                            <td><code class="sp-mono">@item.Code</code></td>
                            <td>@item.Name</td>
                            <td>@item.NameEn</td>
                            <td>
                                <span class="badge @(item.Status == CommonStatus.Enabled ? "bg-success" : "bg-danger")">@EnumReader.GetText(item.Status)</span>
                            </td>
                            <td>
                                <div>@DateTimeTool.UtcToLocal(item.CreateTime, CTZ).ToCommonString()</div>
                                <div class="text-muted small">@DateTimeTool.UtcToLocal(item.UpdateTime, CTZ).ToCommonString()</div>
                            </td>
                            <td class="text-nowrap">
                                <a href="~/Country/Country_Edit?CountryId=@(item.Id)" class="btn btn-sm btn-info">
                                    <i class="fa-solid fa-pen-to-square me-1"></i>@GL.Get("Edit")
                                </a>
                                <button type="button" data-id="@item.Id"
                                        data-status="@(item.Status == CommonStatus.Enabled ? 0 : 1)"
                                        data-api="/api/country"
                                        data-action="geo-status"
                                        class="btn btn-sm @(item.Status == CommonStatus.Enabled ? "btn-outline-secondary" : "btn-success")">
                                    <i class="fa-solid @(item.Status == CommonStatus.Enabled ? "fa-ban" : "fa-circle-check") me-1"></i>@(item.Status == CommonStatus.Enabled ? "停用" : "启用")
                                </button>
                                <button type="button" data-id="@item.Id" data-api="/api/country" data-action="geo-delete" class="btn btn-sm btn-danger">
                                    <i class="fa-solid fa-trash me-1"></i>@GL.Get("Delete")
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="sp-empty">@GL.Get("NoData")</td></tr>
                }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <partial name="~/Views/_Component/_Pager.cshtml" for="@DataPager" />
        </div>
    </div>
</div>

@section Foot {
    <script src="~/assets/js/admin-geo.js?v=@AppInfo.ResVer"></script>
}

@{
    // 全站布局：装配页面标题、当前管理员与面包屑，再渲染外壳结构
    SuperViewInfo viewInfo = ViewBag.ViewInfo;
    LocalizationModule gl = viewInfo.GlobalLanguage;

    CurrentAuthorizationInfo currentAuthorization = ViewBag.CurrentAuthorization;
    AdminDto currentAdmin = currentAuthorization.CurrentAdmin!;
    List<MenuBreadCrumb> menuBreadCrumbList = currentAuthorization.MenuBreadCrumbList ?? new List<MenuBreadCrumb>();

    // 页面标题：优先取 ViewBag.PageTitle，缺省拼面包屑链，末尾追加站点名
    string? PageTitle = ViewBag.PageTitle;
    if (string.IsNullOrEmpty(PageTitle) && menuBreadCrumbList.Any())
    {
        PageTitle = string.Join("_", menuBreadCrumbList.Select(m => m.Title));
    }
    if (!string.IsNullOrEmpty(PageTitle))
    {
        PageTitle += " - ";
    }
    PageTitle += AppInfo.Name;

    // 顶栏展示名：优先真实姓名，缺省账号名；头像缺省取首字母
    string adminDisplay = !string.IsNullOrWhiteSpace(currentAdmin.DisplayName)
        ? currentAdmin.DisplayName!
        : (currentAdmin.Username ?? "Admin");
    string adminInitial = adminDisplay.Length > 0 ? adminDisplay.Substring(0, 1).ToUpperInvariant() : "A";
    string? avatarUrl = currentAdmin.AvatarUrl;
}

<!DOCTYPE html>
<html lang="zh-CN" data-bs-theme="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>@PageTitle</title>
    <link rel="icon" type="image/svg+xml" href="~/assets/img/logo-mark.svg" />

    <link rel="stylesheet" href="~/assets/vendor/bootstrap5.3.2/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/assets/vendor/fontawesome.free.7.2.0/css/all.min.css" />
    <link rel="stylesheet" href="~/assets/css/admin-shell.css?v=@AppInfo.ResVer" />
    @RenderSection("Head", false)
</head>
<body class="sp-body">
    <div class="sp-app">
        <partial name="~/Views/Shared/_Sidebar.cshtml" />

        <div class="sp-main">
            <header class="sp-header">
                <div class="sp-header__left">
                    <button type="button" class="sp-icon-btn" data-sp-toggle-sidebar aria-label="切换侧栏">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                </div>
                <div class="sp-header__right">
                    <div class="sp-admin-menu" id="spAdminMenu">
                        <button type="button" class="sp-admin-chip" data-sp-admin-menu aria-expanded="false">
                            <span class="sp-admin-avatar">
                                @if (!string.IsNullOrEmpty(avatarUrl))
                                {
                                    <img src="@avatarUrl" alt="" />
                                }
                                else
                                {
                                    @adminInitial
                                }
                            </span>
                            <span class="sp-admin-name">@adminDisplay</span>
                            <i class="fa-solid fa-chevron-down" style="font-size:11px;opacity:.7"></i>
                        </button>
                        <div class="sp-admin-dropdown">
                            <a href="~/Personal/EditProfile/"><i class="fa-solid fa-id-card"></i><span>@(gl.Get("EditMyProfile"))</span></a>
                            <a href="~/Personal/ChangePassword/"><i class="fa-solid fa-key"></i><span>@(gl.Get("ChangePassword"))</span></a>
                            <a href="~/Personal/AvatarSetting/"><i class="fa-solid fa-circle-user"></i><span>@(gl.Get("MyProfilePicture"))</span></a>
                            <div class="sp-drop-sep"></div>
                            <a href="javascript:void(0)" data-sp-logout><i class="fa-solid fa-right-from-bracket"></i><span>@(gl.Get("Logout") ?? "退出")</span></a>
                        </div>
                    </div>
                </div>
            </header>

            <main class="sp-content">
                @RenderBody()
            </main>

            <footer class="sp-footer">
                <i class="fa-solid fa-seedling me-1"></i>
                &copy; <span id="spYear"></span> @AppInfo.Name · Naturalist Atlas
            </footer>
        </div>
    </div>

    <script src="~/assets/vendor/jquery3.7.1/jquery-3.7.1.min.js"></script>
    <script src="~/assets/vendor/bootstrap5.3.2/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/js/rpg-core.js?v=@AppInfo.ResVer"></script>
    <script src="~/assets/js/admin-shell.js?v=@AppInfo.ResVer"></script>
    <script>
        document.getElementById('spYear').textContent = new Date().getFullYear();
        RPG.Lang.Confirm = '@(gl.Get("Confirm") ?? "确认")';
        RPG.Lang.Cancel = '@(gl.Get("Cancel") ?? "取消")';
        RPG.Lang.OperationConfirm = '@(gl.Get("OperationConfirm") ?? "确认操作")';
    </script>
    @RenderSection("Foot", false)
</body>
</html>

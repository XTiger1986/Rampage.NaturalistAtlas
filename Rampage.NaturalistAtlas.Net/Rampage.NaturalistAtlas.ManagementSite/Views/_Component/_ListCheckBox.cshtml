@{
    var Selector = Model!;
    Selector.Init();
}

@if (Selector.UseDefault)
{
    <div class="form-check form-check-inline">
        <input type="checkbox" id="@(Selector.FormItemId)" name="@(Selector.FormItemName)" value="@(Selector.DefaultValue)" class="form-check-input" />
        <label for="@(Selector.FormItemId)" class="form-check-label @(Selector.Css)" style="@(Selector.Style)">@(Selector.DefaultText)</label>
    </div>
}
@foreach (var item in Selector.Items)
{
    <div class="form-check form-check-inline">
        <input type="checkbox" id="@(Selector.FormItemId)_@(item.Key)" name="@(Selector.FormItemName)" @Html.Raw(Selector.IsSelected(item.Key) ? "checked=\"checked\"" : "") value="@(item.Key)" class="form-check-input" />
        <label for="@(Selector.FormItemId)_@(item.Key)" class="form-check-label @(Selector.Css)">@(item.Value)</label>
    </div>
}

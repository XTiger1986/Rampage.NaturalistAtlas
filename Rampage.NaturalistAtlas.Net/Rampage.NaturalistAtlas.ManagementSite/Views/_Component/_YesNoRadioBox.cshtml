@{
    var selector = (BooleanSelector)Model!;
    selector.Init();
}

@if (selector.UseDefault)
{
    <div class="form-check form-check-inline">
        <input type="radio" id="@(selector.FormItemId)" name="@(selector.FormItemName)" value="@(selector.DefaultValue)" class="form-check-input" />
        <label for="@(selector.FormItemId)" class="form-check-label @(selector.Css)" style="@(selector.Style)">@(selector.DefaultText)</label>
    </div>
}
<div class="form-check form-check-inline">
    <input type="radio" id="@(selector.FormItemId)_@(YesOrNoStatus.Yes)" name="@(selector.FormItemName)" class="form-check-input" value="True" @Html.Raw(selector.SelectedValue ? "checked=\"checked\"" : "") />
    <label for="@(selector.FormItemId)_@(YesOrNoStatus.Yes)" class="form-check-label @(selector.Css)" style="@(selector.Style)">@(EnumReader.GetText(YesOrNoStatus.Yes))</label>
</div>
<div class="form-check form-check-inline">
    <input type="radio" id="@(selector.FormItemId)_@(YesOrNoStatus.No)" name="@(selector.FormItemName)" class="form-check-input" value="False" @Html.Raw(!selector.SelectedValue ? "checked=\"checked\"" : "") />
    <label for="@(selector.FormItemId)_@(YesOrNoStatus.No)" class="form-check-label @(selector.Css)" style="@(selector.Style)">@(EnumReader.GetText(YesOrNoStatus.No))</label>
</div>


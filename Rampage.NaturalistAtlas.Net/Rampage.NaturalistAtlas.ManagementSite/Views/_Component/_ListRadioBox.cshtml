@{
    var Selector = Model!;
    Selector.Init();
}


@if (Selector.UseDefault)
{
    <div class="form-check form-check-inline">
        <input type="radio" id="@(Selector.FormItemId)" name="@(Selector.FormItemName)" value="@(Selector.DefaultValue)" class="form-check-input" />
        <label for="@(Selector.FormItemId)" class="form-check form-check-inline @(Selector.Css)" style="@(Selector.Style)">@(Selector.DefaultText)</label>
    </div>
}

@foreach (var item in Selector.Items)
{
    <div class="form-check form-check-inline">
        <input type="radio" id="@(Selector.FormItemId)_@(item.Key)" name="@(Selector.FormItemName)" value="@(item.Key)" class="form-check-input" @Html.Raw(Selector.IsSelected(item.Key) ? "checked=\"checked\"" : "") />
        <label for="@(Selector.FormItemId)_@(item.Key)" class="form-check form-check-inline @(Selector.Css)" style="@(Selector.Style)">@(item.Value)</label>
    </div>
}


@model DataPager
@{
    SuperViewInfo viewInfo = ViewBag.ViewInfo;
    LocalizationModule gl = viewInfo.GlobalLanguage;

    DataPager currentPager = Model!;
}

<div id="pager_@(currentPager.Id)" class="row">
    <div class="col-sm-12 col-md-5">
        @if (currentPager.RecordCount > 0)
        {
            <div class="dataTables_info" id="datatable-basic_info" role="status" aria-live="polite"> @(currentPager.BeginIndex)-@(currentPager.EndIndex) / @(currentPager.RecordCount)</div>
        }
    </div>

    <div class="col-sm-12 col-md-7">
        <div class="dataTables_paginate paging_simple_numbers" id="datatable-basic_paginate">
            <ul class="pagination">
                <li id="pagerPrevious_@(currentPager.Id)" class="paginate_button page-item previous@(currentPager.PageIndex == 1 ? " disabled" : "")">
                    <a class="page-link" href="@(currentPager.PageIndex == 1 ? "javascript:void(0)" : currentPager.PrevUrl)" @(currentPager.PageIndex == 1 ? " aria-disabled=\"true\"" : "")>@gl.Get("PreviousPage")</a>
                </li>

                @if (currentPager.PageIndex > 1 && currentPager.StartPage > 1)
                {
                    <li class="paginate_button page-item"><a class="page-link" href="@(currentPager.GetUrl(1))">1</a></li>
                }
                @if (currentPager.StartPage > 2)
                {
                    <li class="paginate_button page-item disabled"><a class="page-link" href="javascript:void(0)">...</a></li>
                }
                @for (long page = currentPager.StartPage; page <= currentPager.EndPage; page++)
                {
                    if (page == currentPager.PageIndex)
                    {
                        <li class="paginate_button page-item active"><a class="page-link" href="@(currentPager.GetUrl(page))">@(page)</a></li>
                    }
                    else
                    {
                        <li class="paginate_button page-item"><a class="page-link" href="@(currentPager.GetUrl(page))">@(page)</a></li>
                    }
                }
                @if (currentPager.TotalPage - currentPager.EndPage >= 2)
                {
                    <li class="paginate_button page-item disabled"><a class="page-link" href="javascript:void(0)">...</a></li>
                }
                @if (currentPager.PageIndex < currentPager.TotalPage && currentPager.EndPage < currentPager.TotalPage)
                {
                    <li class="paginate_button page-item"><a class="page-link" href="@(currentPager.GetUrl(currentPager.TotalPage))">@(currentPager.TotalPage)</a></li>
                }
                <li class="paginate_button page-item next@(currentPager.PageIndex == currentPager.TotalPage ? " disabled" : "")">
                    <a class="page-link" href="@(currentPager.PageIndex == currentPager.TotalPage ? "javascript:void(0)" : currentPager.NextUrl)" @(currentPager.PageIndex == currentPager.TotalPage ? " aria-disabled=\"true\"" : "")>@gl.Get("NextPage") </a>
                </li>

                @if (currentPager.TotalPage > 7)
                {
                    <!-- 跳页：深翻页成本高（10 万+ 观察的列表），按页码直达；page 参数交给 URL API 处理 -->
                    <li class="paginate_button page-item d-flex align-items-center ms-2">
                        <input type="number" min="1" max="@currentPager.TotalPage" value="@currentPager.PageIndex"
                               class="form-control form-control-sm sp-mono" style="width:74px"
                               aria-label="跳转到页码"
                               onkeydown="if(event.key==='Enter'){var v=parseInt(this.value,10);if(v>=1&&v<=@(currentPager.TotalPage)){var u=new URL(window.location.href);u.searchParams.set('page',String(v));window.location.href=u.pathname+u.search;}}" />
                        <span class="ms-1 text-muted small">/ @currentPager.TotalPage</span>
                    </li>
                }

            </ul>
        </div>
    </div>
</div>
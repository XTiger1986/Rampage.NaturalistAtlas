@{
    var selector = (EnumSelector<YesOrNoStatus>)Model!;
    selector.Init();
}


@if (selector.UseDefault)
{
    <label for="@(selector.FormItemId)" class="form-check form-check-inline @(selector.Css)" style="@(selector.Style)">
        <input type="radio" id="@(selector.FormItemId)" name="@(selector.FormItemName)" value="@(selector.DefaultValue)" class="form-check-input" />
        <span class="form-check-label"> @(selector.DefaultText)</span>
    </label>
}
@foreach (var item in selector.Items!)
{
    <label for="@(selector.FormItemId)_@(item.Value)" class="form-check form-check-inline @(selector.Css)" style="@(selector.Style)">
        <input type="radio" id="@(selector.FormItemId)_@(item.Value)" name="@(selector.FormItemName)" @Html.Raw(selector.IsSelected(item.Value) ? "checked=\"checked\"" : "") value="@(item.Value == 1)" class="form-check-input" />
        <span class="form-check-label"> @(item.Text)</span>
    </label>
}


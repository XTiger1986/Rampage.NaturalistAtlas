@model SyncTaskConfigEditDto
@{
    // 采集任务配置编辑：按 task 类型驱动参数表单；未列出的 config 键保存时原样保留
    SuperViewInfo viewInfo = ViewBag.ViewInfo;
    TimeZoneInfo ctz = viewInfo.ClientTimeZone!;
    LocalizationModule gl = viewInfo.GlobalLanguage;
    SyncTaskConfigEditDto data = Model!;
    ViewBag.PageTitle = $"任务配置 - {data.Task}";
    string task = data.Task ?? "";
    bool isBackfill = task == Rampage.NaturalistAtlas.Model.Enums.SyncTaskCodes.Backfill;
    bool isDeletionCheck = task == Rampage.NaturalistAtlas.Model.Enums.SyncTaskCodes.DeletionCheck;
    bool showBatchSize = !isDeletionCheck;
}

@section Head {
    <link rel="stylesheet" href="~/assets/css/admin-sync.css?v=@AppInfo.ResVer" />
}

<div class="sp-page-head">
    <partial name="~/Views/Shared/_BreadCrumb.cshtml" />
    <div class="sp-page-actions">
        <a class="btn btn-outline-secondary" href="~/Sync/Task_List"><i class="fa-solid fa-arrow-left me-1"></i>返回列表</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-3">
        <div class="sp-stat">
            <div class="sp-stat__num">@EnumReader.GetText(data.Source)</div>
            <div class="sp-stat__label">数据源</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sp-stat">
            <div class="sp-stat__num">@(data.CityName ?? data.CityId.ToString())</div>
            <div class="sp-stat__label">城市</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sp-stat">
            <div class="sp-stat__num sp-mono">@(data.Task ?? "-")</div>
            <div class="sp-stat__label">任务类型</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="sp-stat">
            <div class="sp-stat__num">@(data.Watermark.HasValue ? DateTimeTool.UtcToLocal(data.Watermark.Value, ctz).ToCommonString() : "未开始")</div>
            <div class="sp-stat__label">增量水位</div>
        </div>
    </div>
</div>

<div class="sp-panel mb-3">
    <div class="sp-panel__hd">
        <h2 class="sp-panel__title"><i class="fa-solid fa-sliders me-2"></i>任务参数</h2>
    </div>
    <div class="sp-panel__bd">
        <form id="SyncConfigForm" action="~/api/sync/config/save" method="post">
            <input type="hidden" name="Id" value="@data.Id" />

            @if (showBatchSize)
            {
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label" for="txtBatchSize">批量大小（每页条数）</label>
                    <div class="col-sm-9">
                        <input type="number" id="txtBatchSize" name="BatchSize" class="form-control" style="max-width:200px" min="1" max="200" value="@data.BatchSize" placeholder="留空保留原值" />
                        <div class="form-text">采集端分页拉取的每页条数（1 ~ 200）。</div>
                        <div class="invalid-feedback" verify-name="BatchSize"></div>
                    </div>
                </div>
            }

            @if (isBackfill)
            {
                <div class="setting-section-title"><i class="fa-solid fa-clock-rotate-left"></i>回补时间窗</div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label" for="txtFromDate">窗口起始日</label>
                    <div class="col-sm-9">
                        <input type="date" id="txtFromDate" name="FromDate" class="form-control" style="max-width:200px" value="@(data.FromDate?.ToString("yyyy-MM-dd"))" />
                        <div class="form-text">首建回补近 24 个月（产品方案 A）；调整后由采集端按新窗口切片执行。</div>
                        <div class="invalid-feedback" verify-name="FromDate"></div>
                    </div>
                </div>
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label" for="txtToDate">窗口截止日</label>
                    <div class="col-sm-9">
                        <input type="date" id="txtToDate" name="ToDate" class="form-control" style="max-width:200px" value="@(data.ToDate?.ToString("yyyy-MM-dd"))" />
                        <div class="invalid-feedback" verify-name="ToDate"></div>
                    </div>
                </div>
            }

            @if (isDeletionCheck)
            {
                <div class="row mb-3">
                    <label class="col-sm-3 col-form-label" for="txtSampleSize">对账抽样数</label>
                    <div class="col-sm-9">
                        <input type="number" id="txtSampleSize" name="SampleSize" class="form-control" style="max-width:200px" min="1" max="1000" value="@data.SampleSize" placeholder="留空保留原值" />
                        <div class="form-text">周度删除对账每轮抽样的观察数（1 ~ 1000）；比对不一致的记录置为「源站已删除」。</div>
                        <div class="invalid-feedback" verify-name="SampleSize"></div>
                    </div>
                </div>
            }

            <div class="setting-hint">
                <i class="fa-solid fa-circle-info me-1"></i>
                仅覆盖以上表单字段；config 中未列出的参数（采集端扩展键）保存时原样保留。
            </div>

            <div class="d-flex justify-content-center">
                <button class="btn btn-primary px-5" type="submit"><i class="fa-solid fa-floppy-disk me-1"></i>@gl.Get("SubmitToSave")</button>
            </div>
            <div id="tipMessage" class="sp-tip" style="display:none;"></div>
        </form>
    </div>
</div>

<div class="sp-panel">
    <div class="sp-panel__hd">
        <h2 class="sp-panel__title"><i class="fa-solid fa-file-code me-2"></i>当前 config（JSONB 原文）</h2>
    </div>
    <div class="sp-panel__bd">
        @if (!string.IsNullOrWhiteSpace(data.ConfigJson))
        {
            @* JSON raw text pretty-printed with 2-space indent (was Regex-collapsed to one unreadable line; falls back to the raw text when parsing fails) *@
            string pretty = data.ConfigJson!;
                try
                {
                    var node = System.Text.Json.Nodes.JsonNode.Parse(pretty);
                    if (node != null)
                    {
                        pretty = node.ToJsonString(new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
                    }
                }
                catch (System.Text.Json.JsonException)
                {
                    // illegal JSON: show raw / fall back to the raw text
                }
            <pre class="sync-config-pre sp-mono">@pretty</pre>
        }
        else
        {
            <div class="sp-empty">尚未写入参数（首次保存后生成）</div>
        }
        <div class="mt-2 text-muted small">上次运行：@EnumReader.GetText(data.LastRunStatus) · @DateTimeTool.UtcToLocal(data.LastRunTime, ctz).ToCommonString() @(string.IsNullOrWhiteSpace(data.LastRunMessage) ? "" : "· " + data.LastRunMessage)</div>
    </div>
</div>

@section Foot {
    <script>
        $(function () {
            RPG.FormSubmitter('SyncConfigForm', {
                completeHandler: function (jsonResult) {
                    window.location.reload();
                },
                tipContainerId: 'tipMessage',
                tipAutoHidden: 1,
                verifyFeedback: 1
            });
        });
    </script>
}

@model ListViewData<SyncLog, SyncLogAdminFilter>
@{
    // 同步日志列表：来源/城市/任务/状态/时间范围筛选；行内进详情
    SuperViewInfo viewInfo = ViewBag.ViewInfo;
    TimeZoneInfo ctz = viewInfo.ClientTimeZone!;
    LocalizationModule gl = viewInfo.GlobalLanguage;

    List<SyncLog> dataList = Model!.DataList;
    DataPager DataPager = Model!.DataPager!;
    SyncLogAdminFilter dataFilter = Model!.DataFilter;
    List<Rampage.NaturalistAtlas.ManagementSite.Models.CityOption> cityList = ViewBag.CityList ?? new List<Rampage.NaturalistAtlas.ManagementSite.Models.CityOption>();
    Dictionary<int, string> cityNameDict = ViewBag.CityNameDict ?? new Dictionary<int, string>();
    List<string> taskOptions = Rampage.NaturalistAtlas.Model.Enums.SyncTaskCodes.All.ToList();
}

@section Head {
    <link rel="stylesheet" href="~/assets/css/admin-sync.css?v=@AppInfo.ResVer" />
}

<div class="sp-page-head">
    <partial name="~/Views/Shared/_BreadCrumb.cshtml" />
</div>

<div class="sp-panel">
    <div class="sp-panel__hd">
        <h2 class="sp-panel__title"><i class="fa-solid fa-scroll me-2"></i>同步日志</h2>
    </div>
    <div class="sp-panel__bd">
        <form class="sp-toolbar" action="~/Sync/Log_List" method="get">
            <div class="sp-toolbar__filters">
                <partial name="~/Views/_Component/_PageSizeOptions.cshtml" model="DataPager.PageSize" />
                <partial name="~/Views/_Component/_EnumSelector.cshtml"
                         model='new EnumSelector<AtlasSource> { FormItemId = "seltSource", FormItemName = "Source", Css = "form-select", Style = "width:130px", DefaultText = "全部来源", DefaultValue = "", SelectedValue = dataFilter.Source }' />
                <select name="CityId" class="form-select" style="width:120px">
                    <option value="">全部城市</option>
                    @foreach (var city in cityList)
                    {
                        <option value="@city.Id" selected="@(dataFilter.CityId == city.Id)">@city.DisplayName</option>
                    }
                </select>
                <select name="Task" class="form-select" style="width:150px">
                    <option value="">全部任务类型</option>
                    @foreach (var task in taskOptions)
                    {
                        <option value="@task" selected="@(dataFilter.Task == task)">@SyncTaskCodes.LabelOf(task)</option>
                    }
                </select>
                <partial name="~/Views/_Component/_EnumSelector.cshtml"
                         model='new EnumSelector<SyncLogStatus> { FormItemId = "seltStatus", FormItemName = "Status", Css = "form-select", Style = "width:130px", DefaultText = "全部状态", DefaultValue = "", SelectedValue = dataFilter.Status }' />
            </div>
            <div class="sp-toolbar__filters">
                <span class="sp-toolbar__label">开始时间</span>
                <input type="date" name="StartTimeFrom" class="form-control" style="width:150px" value="@(dataFilter.StartTimeFrom?.ToString("yyyy-MM-dd"))" />
                <span class="sp-toolbar__label">至</span>
                <input type="date" name="StartTimeTo" class="form-control" style="width:150px" value="@(dataFilter.StartTimeTo?.ToString("yyyy-MM-dd"))" />
                <button type="submit" class="btn btn-primary">@gl.Get("Query")</button>
                <button type="button" id="btnExportLogCsv" class="btn btn-outline-success" title="按当前筛选导出最多 5000 行 CSV">
                    <i class="fa-solid fa-file-csv me-1"></i>导出 CSV
                </button>
            </div>
        </form>

        <div class="sp-table-wrap">
            <table class="table table-hover sp-table">
                <thead>
                    <tr>
                        <th>开始时间</th>
                        <th>来源 / 城市</th>
                        <th>任务</th>
                        <th>状态</th>
                        <th>请求</th>
                        <th>新增 / 更新 / 失败</th>
                        <th>耗时</th>
                        <th>摘要</th>
                        <th>操作</th>
                    </tr>
                </thead>
                <tbody>
                @if (dataList.Count > 0)
                {
                    foreach (var item in dataList)
                    {
                        <tr id="trDataItem_@(item.Id)">
                            <td>@DateTimeTool.UtcToLocal(item.StartTime, ctz).ToCommonString()</td>
                            <td>
                                <div>@EnumReader.GetText(item.Source)</div>
                                <div class="text-muted small">@(cityNameDict.TryGetValue(item.CityId, out string? cityName) ? cityName : item.CityId.ToString())</div>
                            </td>
                            <td><code class="sp-mono" title="@item.Task">@SyncTaskCodes.LabelOf(item.Task)</code></td>
                            <td>
                                <span class="badge @(item.Status == SyncLogStatus.Success ? "bg-success" : (item.Status == SyncLogStatus.Failed ? "bg-danger" : (item.Status == SyncLogStatus.CircuitSkipped ? "bg-secondary" : "bg-info")))">@EnumReader.GetText(item.Status)</span>
                            </td>
                            <td>@item.RequestCount</td>
                            <td class="sp-mono">@item.InsertCount / @item.UpdateCount / @item.FailCount</td>
                            <td>@(item.EndTime.HasValue ? (item.EndTime.Value - item.StartTime).ToString(@"mm\:ss") : "-")</td>
                            <td style="max-width:240px" class="small">@(string.IsNullOrWhiteSpace(item.Message) ? "-" : item.Message)</td>
                            <td class="text-nowrap">
                                <a href="~/Sync/Log_Detail?LogId=@(item.Id)" class="btn btn-sm btn-info">
                                    <i class="fa-solid fa-magnifying-glass me-1"></i>详情
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="9" class="sp-empty">@gl.Get("NoData")</td></tr>
                }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <partial name="~/Views/_Component/_Pager.cshtml" for="@DataPager" />
        </div>
    </div>
</div>

@section Foot {
    <script>
        $(function () {
            $('#btnExportLogCsv').on('click', function () {
                var q = $('form.sp-toolbar').serialize();
                window.location.href = '/api/sync/log/export' + (q ? '?' + q : '');
            });
        });
    </script>
}

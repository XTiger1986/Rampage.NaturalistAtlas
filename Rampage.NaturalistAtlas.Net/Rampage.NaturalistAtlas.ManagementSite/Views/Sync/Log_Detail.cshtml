@model SyncLog
@{
    // 同步日志详情：起止时间、计数、运行摘要
    SuperViewInfo ViewInfo = ViewBag.ViewInfo;
    TimeZoneInfo CTZ = ViewInfo.ClientTimeZone!;
    LocalizationModule GL = ViewInfo.GlobalLanguage;
    SyncLog Data = Model!;
    string? CityName = ViewBag.CityName;
    ViewBag.PageTitle = $"同步日志 - {Data.Task}";
}

@section Head {
    <link rel="stylesheet" href="~/assets/css/admin-sync.css?v=@AppInfo.ResVer" />
}

<div class="sp-page-head">
    <partial name="~/Views/Shared/_BreadCrumb.cshtml" />
    <div class="sp-page-actions">
        <a class="btn btn-outline-secondary" href="~/Sync/Log_List"><i class="fa-solid fa-arrow-left me-1"></i>返回列表</a>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-6 col-md-2">
        <div class="sp-stat">
            <div class="sp-stat__num">@Data.RequestCount.ToString("N0")</div>
            <div class="sp-stat__label">请求次数</div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="sp-stat">
            <div class="sp-stat__num">@Data.InsertCount.ToString("N0")</div>
            <div class="sp-stat__label">新增</div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="sp-stat">
            <div class="sp-stat__num">@Data.UpdateCount.ToString("N0")</div>
            <div class="sp-stat__label">更新</div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="sp-stat">
            <div class="sp-stat__num">@Data.FailCount.ToString("N0")</div>
            <div class="sp-stat__label">失败</div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="sp-stat">
            <div class="sp-stat__num">@(Data.EndTime.HasValue ? (Data.EndTime.Value - Data.StartTime).ToString(@"hh\:mm\:ss") : "-")</div>
            <div class="sp-stat__label">耗时</div>
        </div>
    </div>
    <div class="col-6 col-md-2">
        <div class="sp-stat">
            <div class="sp-stat__num"><span class="badge @(Data.Status == SyncLogStatus.Success ? "bg-success" : (Data.Status == SyncLogStatus.Failed ? "bg-danger" : (Data.Status == SyncLogStatus.CircuitSkipped ? "bg-secondary" : "bg-info")))">@EnumReader.GetText(Data.Status)</span></div>
            <div class="sp-stat__label">运行状态</div>
        </div>
    </div>
</div>

<div class="sp-panel">
    <div class="sp-panel__hd">
        <h2 class="sp-panel__title"><i class="fa-solid fa-scroll me-2"></i>运行详情</h2>
    </div>
    <div class="sp-panel__bd">
        <div class="row mb-2">
            <label class="col-sm-3 col-form-label">来源 / 城市</label>
            <div class="col-sm-9"><p class="form-control-plaintext">@EnumReader.GetText(Data.Source) · @(CityName ?? Data.CityId.ToString())</p></div>
        </div>
        <div class="row mb-2">
            <label class="col-sm-3 col-form-label">任务类型</label>
            <div class="col-sm-9"><p class="form-control-plaintext sp-mono">@(Data.Task ?? "-")</p></div>
        </div>
        <div class="row mb-2">
            <label class="col-sm-3 col-form-label">开始时间（UTC）</label>
            <div class="col-sm-9"><p class="form-control-plaintext">@DateTimeTool.UtcToLocal(Data.StartTime, CTZ).ToCommonString()</p></div>
        </div>
        <div class="row mb-2">
            <label class="col-sm-3 col-form-label">结束时间（UTC）</label>
            <div class="col-sm-9"><p class="form-control-plaintext">@(Data.EndTime.HasValue ? DateTimeTool.UtcToLocal(Data.EndTime.Value, CTZ).ToCommonString() : "运行中")</p></div>
        </div>
        <div class="row mb-2">
            <label class="col-sm-3 col-form-label">本地日志Id</label>
            <div class="col-sm-9"><p class="form-control-plaintext sp-mono">@Data.Id</p></div>
        </div>
        <div class="row mb-2">
            <label class="col-sm-3 col-form-label">运行摘要</label>
            <div class="col-sm-9"><p class="form-control-plaintext">@(string.IsNullOrWhiteSpace(Data.Message) ? "-" : Data.Message)</p></div>
        </div>
    </div>
</div>
